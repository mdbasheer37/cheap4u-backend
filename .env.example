# ════════════════════════════════════════
#  Makari Islamic TV — Environment Config
# ════════════════════════════════════════

# ── PostgreSQL (required) ────────────────────────────────────
# Get this from Render → your PostgreSQL service → Connect → "External Database URL"
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://makari_admin:yourpassword@dpg-xxxx.oregon-postgres.render.com/makari_tv

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-minimum-32-characters

# ── App ──────────────────────────────────────────────────────
ENVIRONMENT=production
