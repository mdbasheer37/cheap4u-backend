    result = buy_electricity(
        disco=data.get('disco'),
        meter_number=data.get('meter_number'),
        meter_type=data.get('meter_type'),
        amount=data.get('amount'),
        phone=data.get('phone'),
        user_email=data.get('user_email')
    )
    return jsonify(result)

